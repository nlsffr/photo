# =============================================================================
# LumenGallery / photo — Environment template
# =============================================================================
# Production target (July 2026):
#   - Origin ............. Parkinhost Russia Dedicated (~€110/mo)
#                        Xeon E3 / 16 GB RAM / 2×16 TB HDD / 1 Gbps / Moscow
#   - Media storage ...... Self-hosted MinIO on the SAME server (most anonymous)
#   - Edge / DDoS ........ DDoS-Guard Website Protection (hides origin IP)
#   - SQL database ....... MariaDB 11.x on the same server (encrypted at rest)
# =============================================================================

# ---- Database (MariaDB on the Parkinhost dedicated) ----
DATABASE_URL=mysql://lumen:change-me-strong@mariadb:3306/lumengallery
# Encrypt the DB connection in transit (TLS). Always true in prod.
DB_SSL=true
# PEM contents of the CA that signed the DB server cert (prod).
DB_SSL_CA=
DB_POOL_SIZE=10

# ---- Redis (cache, on dedicated) ----
REDIS_URL=redis://redis:6379

# ---- Elasticsearch (optional search, on dedicated) ----
# 16 GB RAM → can give ES more headroom than on a small VPS
ELASTICSEARCH_URL=http://elasticsearch:9200

# ---- Media storage: MinIO (self-hosted on the Parkinhost dedicated) ----
# Most anonymous option: you control the keys, no third-party account.
# Bucket stays PRIVATE. Media is served via signed URLs or through the edge.
# Put the large media volume on the 2×16 TB HDDs.
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin-change-me
S3_SECRET_KEY=minioadmin-change-me-strong
S3_BUCKET=lumengallery-media
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

# ---- CDN (optional) ----
# If you put a CDN later, point it at the private MinIO origin (still behind DDoS).
CDN_URL=
CDN_HOSTNAME=

# ---- Email (Proton Mail via SMTP) ----
SMTP_HOST=smtp.proton.me
SMTP_PORT=587
SMTP_USER=your-proton-email@proton.me
SMTP_PASS=your-app-password

# ---- Application ----
NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# ---- Security ----
JWT_SECRET=your-secret-key-min-32-chars-change-me
SESSION_SECRET=your-session-secret-key-change-me

# ---- Production deploy (docker-compose.prod.yml) ----
IMAGE=lumengallery:latest
DB_ROOT_PASSWORD=change-me-strong-root
DB_NAME=lumengallery
DB_USER=lumen
DB_PASSWORD=change-me-strong
