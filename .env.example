# Database
DATABASE_URL=mysql://user:password@localhost:3306/lumengallery
# Encrypt the DB connection in transit (TLS). Set true in prod.
DB_SSL=false
# PEM contents of the CA that signed the DB server cert (prod).
DB_SSL_CA=
DB_POOL_SIZE=10

# Redis
REDIS_URL=redis://localhost:6379

# Elasticsearch
ELASTICSEARCH_URL=http://localhost:9200

# S3 / Minio
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=lumengallery-media
S3_REGION=us-east-1

# CDN
CDN_URL=https://cdn.example.com
CDN_HOSTNAME=cdn.example.com

# Email (Proton Mail via SMTP)
SMTP_HOST=smtp.proton.me
SMTP_PORT=587
SMTP_USER=your-proton-email@proton.me
SMTP_PASS=your-app-password

# Application
NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# Security
JWT_SECRET=your-secret-key-min-32-chars
SESSION_SECRET=your-session-secret-key

# --- Production deploy (docker-compose.prod.yml) ---
# Image tag pushed to your private Harbor registry.
IMAGE=lumengallery:latest
# MariaDB credentials (compose provisions the DB with these).
DB_ROOT_PASSWORD=change-me-strong
DB_NAME=lumengallery
DB_USER=lumen
DB_PASSWORD=change-me-strong
