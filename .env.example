# =============================================================================
# LumenGallery / photo — Environment template
# =============================================================================
# Production target:
#   - Origin VPS ........ Abelohost Storage Pro (~€39.99/mo, NL, 4GB RAM / 2CPU / 200GB)
#   - Media storage ..... Backblaze B2 (S3-compatible, cheap unlimited scale)
#   - Edge / DDoS ....... DDoS-Guard (or equivalent no-log anti-DDoS of your choice)
#   - SQL database ...... MariaDB 11.x on the same VPS (encrypted at rest)
# =============================================================================

# ---- Database (MariaDB on the Abelohost VPS) ----
DATABASE_URL=mysql://lumen:change-me-strong@mariadb:3306/lumengallery
# Encrypt the DB connection in transit (TLS). Always true in prod.
DB_SSL=true
# PEM contents of the CA that signed the DB server cert (prod).
DB_SSL_CA=
DB_POOL_SIZE=10

# ---- Redis (cache, on VPS) ----
REDIS_URL=redis://redis:6379

# ---- Elasticsearch (optional search, on VPS) ----
ELASTICSEARCH_URL=http://elasticsearch:9200

# ---- Media storage: Backblaze B2 (S3-compatible) ----
# Create a B2 bucket (private!), Application Key with read/write on that bucket only.
# Endpoint format: https://s3.<region>.backblazeb2.com
# Example region: us-west-004, eu-central-003, etc. (see your B2 dashboard)
S3_ENDPOINT=https://s3.us-west-004.backblazeb2.com
S3_ACCESS_KEY=your-b2-key-id
S3_SECRET_KEY=your-b2-application-key
S3_BUCKET=lumengallery-media
S3_REGION=us-west-004
# Force path-style URLs if needed by the SDK (B2 supports both)
S3_FORCE_PATH_STYLE=true

# ---- CDN (optional but recommended — put a CDN in front of B2, still behind DDoS) ----
CDN_URL=https://cdn.yourdomain.example
CDN_HOSTNAME=cdn.yourdomain.example

# ---- Email (Proton Mail via SMTP) ----
SMTP_HOST=smtp.proton.me
SMTP_PORT=587
SMTP_USER=your-proton-email@proton.me
SMTP_PASS=your-app-password

# ---- Application ----
NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# ---- Security ----
JWT_SECRET=your-secret-key-min-32-chars-change-me
SESSION_SECRET=your-session-secret-key-change-me

# ---- Production deploy (docker-compose.prod.yml) ----
# Image tag pushed to your private Harbor registry (or local build).
IMAGE=lumengallery:latest
# MariaDB credentials (compose provisions the DB with these).
DB_ROOT_PASSWORD=change-me-strong-root
DB_NAME=lumengallery
DB_USER=lumen
DB_PASSWORD=change-me-strong
