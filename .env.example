# =============================================================================
# LumenGallery / photo — Environment template
# =============================================================================
# Production target (July 2026):
#   - Origin ............. Parkinhost Russia Dedicated (~€110/mo)
#                        Xeon E3 / 16 GB RAM / 2×16 TB HDD / 1 Gbps / Moscow
#   - Media storage ...... Self-hosted MinIO on the SAME server
#   - Edge / DDoS ........ DDoS-Guard Website Protection
#   - SQL database ....... MariaDB 11.x on the same server
# =============================================================================

# ---- Database (MariaDB on the Parkinhost dedicated) ----
# From the app container use host "mariadb". From the host/bot use 127.0.0.1.
DATABASE_URL=mysql://lumen:change-me-strong@mariadb:3306/lumengallery
# Internal Docker MariaDB has no TLS by default — keep false unless you set certs.
DB_SSL=false
DB_SSL_CA=
DB_POOL_SIZE=10

# ---- Redis ----
REDIS_URL=redis://redis:6379

# ---- Elasticsearch ----
ELASTICSEARCH_URL=http://elasticsearch:9200

# ---- MinIO (self-hosted) ----
# App container → http://minio:9000
# Bot on host   → http://127.0.0.1:9000
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin-change-me
S3_SECRET_KEY=minioadmin-change-me-strong
S3_BUCKET=lumengallery-media
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

# ---- CDN (optional) ----
CDN_URL=
CDN_HOSTNAME=

# ---- Contact / DMCA / report forms ----
# The inbox that receives every form submission (required to enable sending).
CONTACT_TO=you@example.com
# Verified sender address. Defaults to "LumenGallery <CONTACT_TO>" if omitted.
# With Resend, this must be an address on a domain you've verified there.
CONTACT_FROM=LumenGallery <noreply@yourdomain.com>

# Option A (recommended): Resend — get a free API key at resend.com
RESEND_API_KEY=

# Option B (fallback): SMTP (e.g. Proton Mail). Used only if RESEND_API_KEY is empty.
SMTP_HOST=smtp.proton.me
SMTP_PORT=587
SMTP_USER=your-proton-email@proton.me
SMTP_PASS=your-app-password

# ---- Application ----
NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# ---- Security ----
JWT_SECRET=your-secret-key-min-32-chars-change-me
SESSION_SECRET=your-session-secret-key-change-me

# ---- Production deploy (docker-compose.prod.yml) ----
IMAGE=lumengallery:latest
DB_ROOT_PASSWORD=change-me-strong-root
DB_NAME=lumengallery
DB_USER=lumen
DB_PASSWORD=change-me-strong
