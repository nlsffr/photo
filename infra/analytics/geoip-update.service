[Unit]
Description=Refresh the local country-only GeoIP database
After=docker.service network-online.target
Requires=docker.service

[Service]
Type=oneshot
TimeoutStartSec=120
# Use the same verified image as the running app; the app itself mounts GeoIP ro.
ExecStart=/bin/sh -c 'exec /usr/bin/docker run --rm --pull never --network bridge --mount type=bind,src=/opt/photo/geoip,dst=/geoip --env ANALYTICS_COUNTRY_DB=/geoip/country.mmdb "$(/usr/bin/docker inspect --format={{.Image}} photo-app-1)" node scripts/update-country-db.mjs'
