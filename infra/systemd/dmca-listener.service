[Unit]
Description=DMCA listener (mails)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/photo/dmca
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/flock --nonblock /run/dmca-listener.lock /bin/bash -lc 'set -a && . /opt/photo/dmca/.env && set +a && exec python3 /opt/photo/dmca/dmca_listener.py'
TimeoutStartSec=30min
