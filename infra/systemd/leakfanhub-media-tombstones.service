[Unit]
Description=Refresh removed-media nginx tombstones
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
EnvironmentFile=-/opt/photo/.env
EnvironmentFile=-/opt/photo/.env.prod
ExecStart=/usr/bin/python3 /opt/photo-media-safety/current/ops/refresh-removed-media-map.py --output /opt/photo/infra/nginx/generated/removed-media-maps.conf --docker-bin /usr/bin/docker --edge-container photo-edge-1 --database-container photo-mariadb-1 --preserve-existing
TimeoutStartSec=90s
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/photo/infra/nginx/generated /run
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
