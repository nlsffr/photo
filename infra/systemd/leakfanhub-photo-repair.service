[Unit]
Description=LeakFanHub - restauration bornee des images manquantes
Wants=network-online.target
After=network-online.target docker.service
[Service]
Type=oneshot
User=root
Group=root
UMask=0077
Environment=PYTHONPATH=/opt/megabot-queue/current
Environment=MEDIA_REPAIR_DIRECT_CDN=1
Environment=MEDIA_REPAIR_LOCAL_CACHE=/opt/megabot/downloads
ExecStartPre=/opt/megabot/venv/bin/python -B /opt/photo-image-repair/current/ops/extend-media-repair-plan.py --recover --plan /var/lib/photo-repair/plan.json --state-dir /var/lib/photo-repair/backfill
ExecStart=/opt/megabot/venv/bin/python -B /opt/photo-image-repair/current/ops/run-media-repair-workers.py --kind photo --plan /var/lib/photo-repair/plan.json --state-dir /var/lib/photo-repair/backfill --job-lock-dir /var/lib/video-repair/job-locks --source-backoff /var/lib/video-repair/backfill/source-backoff.json --workers 2 --max-items 100 --delay 2 --priority-ids /var/lib/photo-repair/backfill/cache-priority.json
TimeoutStartSec=1800
TimeoutStopSec=30
KillMode=control-group
Nice=10
